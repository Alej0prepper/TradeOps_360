<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_adjustment_wizard" model="ir.ui.view">
        <field name="name">trade.reconciliation.adjustment.wizard.form</field>
        <field name="model">trade.reconciliation.adjustment.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Commercial Adjustment">
                <group>
                    <field name="reconciliation_id" readonly="True"/>
                    <field name="company_id" invisible="True"/>
                    <field name="currency_id"/>
                    <field name="amount"/>
                    <field name="reason"/>
                    <field name="request_token" invisible="True"/>
                </group>
                <p>The confirmed statement stays unchanged. A correction is a separate immutable record.</p>
                <footer>
                    <button name="action_apply" type="object" string="Record Adjustment" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
