<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_trade_import_tree" model="ir.ui.view">
        <field name="name">trade.import.tree</field>
        <field name="model">trade.import</field>
        <field name="arch" type="xml">
            <tree string="Imports">
                <field name="name"/>
                <field name="import_date"/>
                <field name="customer_id"/>
                <field name="origin_port_id"/>
                <field name="destination_port_id"/>
                <field name="currency_id" invisible="1"/>
                <field name="landed_total" sum="Total"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_trade_import_form" model="ir.ui.view">
        <field name="name">trade.import.form</field>
        <field name="model">trade.import</field>
        <field name="arch" type="xml">
            <form string="Import">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Operation">
                            <field name="import_date"/>
                            <field name="customer_id"/>
                            <field name="financier_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="Route">
                            <field name="origin_port_id"/>
                            <field name="destination_port_id"/>
                            <field name="line_count" readonly="1"/>
                            <field name="total_quantity" readonly="1"/>
                            <field name="purchase_total" readonly="1"/>
                            <field name="expense_total" readonly="1"/>
                            <field name="landed_total" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="unit_purchase_price"/>
                                    <field name="purchase_subtotal" readonly="1"/>
                                    <field name="allocated_expense" readonly="1"/>
                                    <field name="real_total_cost" readonly="1"/>
                                    <field name="real_unit_cost" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Import Expenses">
                            <field name="expense_ids">
                                <tree editable="bottom">
                                    <field name="expense_type"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="amount"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="reference"/>
                            <field name="notes" placeholder="Operational notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_trade_import" model="ir.actions.act_window">
        <field name="name">Imports</field>
        <field name="res_model">trade.import</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_tradeops_root" name="TradeOps" sequence="10"/>
    <menuitem
        id="menu_tradeops_imports"
        name="Imports"
        parent="menu_tradeops_root"
        action="action_trade_import"
        sequence="10"
    />
</odoo>
