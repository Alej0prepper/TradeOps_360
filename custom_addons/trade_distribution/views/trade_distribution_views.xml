<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_trade_distribution_tree" model="ir.ui.view">
        <field name="name">trade.distribution.tree</field>
        <field name="model">trade.distribution</field>
        <field name="arch" type="xml"><tree string="Distributions"><field name="name"/><field name="sale_order_id"/><field name="picking_id"/><field name="expected_quantity"/><field name="delivered_quantity"/><field name="pending_quantity"/></tree></field>
    </record>
    <record id="view_trade_distribution_form" model="ir.ui.view">
        <field name="name">trade.distribution.form</field>
        <field name="model">trade.distribution</field>
        <field name="arch" type="xml">
            <form string="Distribution"><header><button name="action_report_incident" type="object" string="Report Incident" class="btn-primary"/><field name="pending_quantity" invisible="1"/></header><sheet><group><field name="name"/><field name="sale_order_id"/><field name="picking_id"/><field name="company_id" groups="base.group_multi_company"/><field name="expected_quantity"/><field name="delivered_quantity" readonly="1"/><field name="pending_quantity" readonly="1"/></group><notebook><page string="Incidents"><field name="incident_ids"><tree><field name="incident_date"/><field name="incident_type"/><field name="description"/></tree></field></page></notebook></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form>
        </field>
    </record>
    <record id="action_trade_distribution" model="ir.actions.act_window"><field name="name">Distributions</field><field name="res_model">trade.distribution</field><field name="view_mode">tree,form</field></record>
    <menuitem id="menu_tradeops_distributions" name="Distributions" parent="trade_import.menu_tradeops_root" action="action_trade_distribution" sequence="30"/>
</odoo>
