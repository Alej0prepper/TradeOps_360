<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_import_commitments" model="ir.ui.view">
        <field name="name">trade.import.form.commitments</field><field name="model">trade.import</field>
        <field name="inherit_id" ref="trade_import.view_trade_import_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/tree" position="attributes"><attribute name="decoration-danger">overcommitted</attribute></xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='quantity']" position="after">
                <field name="committed_quantity" string="Commercial commitment"/>
                <field name="uncommitted_quantity" string="Uncommitted expectation"/>
                <field name="overcommitted" column_invisible="True"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Presales"><field name="presale_ids" readonly="True"><tree><field name="name"/><field name="customer_id"/><field name="state"/></tree></field></page>
            </xpath>
        </field>
    </record>
</odoo>
