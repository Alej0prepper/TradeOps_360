<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_tradeops" model="ir.module.category">
        <field name="name">TradeOps</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_trade_viewer" model="res.groups">
        <field name="name">Consultation</field>
        <field name="category_id" ref="module_category_tradeops"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_trade_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="category_id" ref="module_category_tradeops"/>
        <field name="implied_ids" eval="[(4, ref('group_trade_viewer')), (4, ref('stock.group_stock_user')), (4, ref('purchase.group_purchase_user')), (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>
    <record id="group_trade_manager" model="res.groups">
        <field name="name">Responsible</field>
        <field name="category_id" ref="module_category_tradeops"/>
        <field name="implied_ids" eval="[(4, ref('group_trade_operator')), (4, ref('stock.group_stock_manager')), (4, ref('purchase.group_purchase_manager')), (4, ref('sales_team.group_sale_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
