<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_trade_port_tree" model="ir.ui.view">
        <field name="name">trade.port.tree</field><field name="model">trade.port</field>
        <field name="arch" type="xml"><tree><field name="name"/><field name="code"/><field name="active"/></tree></field>
    </record>
    <record id="view_trade_port_form" model="ir.ui.view">
        <field name="name">trade.port.form</field><field name="model">trade.port</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="code"/><field name="active"/></group></sheet></form></field>
    </record>
    <record id="action_trade_port" model="ir.actions.act_window">
        <field name="name">Ports</field><field name="res_model">trade.port</field><field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_tradeops_root" name="TradeOps" sequence="10" groups="group_trade_viewer"/>
    <menuitem id="menu_tradeops_configuration" name="Configuration" parent="menu_tradeops_root" sequence="90" groups="group_trade_manager"/>
    <menuitem id="menu_tradeops_ports" name="Ports" parent="menu_tradeops_configuration" action="action_trade_port"/>
</odoo>
